# Скопируйте этот файл в .env и подставьте свои значения.
# Формат строки подключения: postgresql+psycopg2://<пользователь>:<пароль>@<хост>:<порт>/<имя_базы>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/comment_classifier

# Секретный ключ для подписи JWT-токенов. Сгенерируйте свой командой:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=замените-на-длинную-случайную-строку

# Сроки жизни токенов (необязательно, ниже значения по умолчанию)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7